-- table over the live audit table.
ALTER EVENT TRIGGER pgaudix_drop_cleanup DISABLE;
DROP TABLE public.test_swap_c;
ALTER EVENT TRIGGER pgaudix_drop_cleanup ENABLE ALWAYS;
