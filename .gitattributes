# Force LF line endings for files used by pg_regress
test/**/*.sql text eol=lf
test/**/*.out text eol=lf

# SQL files used by PostgreSQL
*.sql text eol=lf

# C source files
*.c text eol=lf
*.h text eol=lf

# Shell/Make/Docker files must stay LF even on Windows checkouts;
# Windows batch files are CRLF
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.bat text eol=crlf
